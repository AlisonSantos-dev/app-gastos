# ==========================================
# Banco de dados (ambiente local)
# Copie este arquivo para .env e defina uma senha
# ==========================================
DB_NAME=appgastos
DB_USER=appgastos
DB_PASSWORD=troque-esta-senha
DB_PORT=5432

# ==========================================
# Pluggy (Open Finance)
# Credenciais da aplicação no dashboard.pluggy.ai (Aplicações)
# ==========================================
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=

# Ids das conexões (items) com os bancos, separados por vírgula
PLUGGY_ITEM_IDS=